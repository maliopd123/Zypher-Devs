@{
    ViewData["Title"] = "Recuperar Senha";
}

<div class="auth-page">
    <div class="auth-wrap">
        <div class="auth-card">
            @if (ViewBag.Sucesso == true)
            {
                <div class="auth-head">
                    <div class="check-icon">OK</div>
                    <h1 class="auth-title">Email enviado!</h1>
                    <p class="auth-subtitle muted">Verifique seu email para redefinir sua senha</p>
                </div>
                <a class="btn primary" asp-controller="Auth" asp-action="Login">Voltar ao login</a>
            }
            else
            {
                <div class="auth-head">
                    @await Html.PartialAsync("_Logo")
                    <h1 class="auth-title">Recuperar Senha</h1>
                    <p class="auth-subtitle muted">Insira seu email para receber instrucoes</p>
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.Erro))
                {
                    <div class="message error">@ViewBag.Erro</div>
                }

                <form class="form-stack" method="post" asp-controller="Auth" asp-action="ForgotPassword">
                    <div class="field">
                        <label for="email">Email</label>
                        <input class="input" id="email" name="email" type="email" placeholder="seu.email@example.com" required />
                    </div>
                    <button class="btn primary" type="submit">Enviar</button>
                </form>

                <div class="auth-links">
                    <a class="auth-link secondary" asp-controller="Auth" asp-action="Login">Voltar ao login</a>
                </div>
            }
        </div>
    </div>
</div>
