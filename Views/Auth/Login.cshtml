@{
    ViewData["Title"] = "Login";
}

<div class="auth-page">
    <div class="auth-wrap">
        <div class="auth-card">
            <div class="auth-head">
                @await Html.PartialAsync("_Logo")
                <h1 class="auth-title">Projeto Chaves</h1>
                <p class="auth-subtitle muted">Acesso seguro ao sistema</p>
            </div>

            @if (!string.IsNullOrEmpty(ViewBag.Erro))
            {
                <div class="message error">@ViewBag.Erro</div>
            }

            <form class="form-stack" method="post" asp-controller="Auth" asp-action="Login">
                <div class="field">
                    <label for="matricula">Digito seis-codigo de acesso unico</label>
                    <input class="input" id="matricula" name="matricula" type="text" placeholder="ex: 00-0000" required />
                    <p class="hint">Exemplo: 00-0000</p>
                </div>

                <div class="field">
                    <label for="senha">Senha</label>
                    <div class="password-row">
                        <input class="input" id="senha" name="senha" type="password" placeholder="Digite sua senha" required />
                        <button class="icon-btn" type="button" data-toggle-password="senha" title="Mostrar senha">ver</button>
                    </div>
                </div>

                <button class="btn primary" type="submit">Entrar</button>
            </form>

            <div class="auth-links">
                <a class="auth-link" asp-controller="Auth" asp-action="ForgotPassword">Esqueceu sua senha?</a>
                <a class="auth-link secondary" asp-controller="Auth" asp-action="Cadastro">Nao tem conta? Cadastre-se</a>
            </div>
        </div>
        <p class="auth-footer">Instituto Federal de Rondonia</p>
    </div>
</div>
