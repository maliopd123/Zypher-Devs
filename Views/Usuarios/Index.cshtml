@model IEnumerable<ProjetoChaves.Models.Usuario>

@{
    ViewData["Title"] = "Usuários";
    ViewData["CurrentPage"] = "usuarios";
    ViewData["ShellTitle"] = "Usuários";

    var usuarios = Model?.ToList() ?? new List<ProjetoChaves.Models.Usuario>();
}

@await Html.PartialAsync("_DashboardShellStart")

<div class="page-stack">

    <div class="page-head">
        <h2>Usuários</h2>
        <p class="muted">Consulte os usuários cadastrados no sistema.</p>
    </div>

    <div class="toolbar">
        <input class="input" type="text" placeholder="Buscar usuário..." />

        <a class="btn outline"
           asp-controller="Auth"
           asp-action="Cadastro">
            Novo usuário
        </a>
    </div>

    <section class="panel table-wrap">

        <table class="data-table">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Email</th>
                    <th>Senha</th>
                </tr>
            </thead>

            <tbody>

                @if (usuarios.Any())
                {
                    foreach (var usuario in usuarios)
                    {
                        <tr>
                            <td>@usuario.Id</td>
                            <td>@usuario.Nome</td>
                            <td>@usuario.Email</td>
                            <td>@usuario.Senha</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4">
                            Nenhum usuário cadastrado.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </section>

</div>

@await Html.PartialAsync("_DashboardShellEnd")